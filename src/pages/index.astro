---
// Home del rediseño — concepto "En producción". Rama `rediseno`, no toca el sitio publicado.
// Serio con chispa: oscuro, acento ámbar, serif (Newsreader) solo en afirmaciones, mono para identificadores.
// Evidencia de sistemas confidenciales = diagrama con firma + reconstrucción de UI con datos de ejemplo.
const videos = [
  { t: "Soft Robotics — demo final", id: "Nmk_etXFZ6o" },
  { t: "PuzzleBot — ROS 2", id: "sOlqaHjRg6w" },
  { t: "Line-Maze Solver", id: "7IuBa7F5US0" },
];
const principios = [
  "Mido antes de tocar.",
  "Un postmortem se vuelve regla.",
  "Cuando la documentación y la base de datos se contradicen, gana la base.",
  "La IA multiplica mi producción; la arquitectura, la seguridad y la responsabilidad de operar son mías.",
  "La seguridad y la privacidad son del diseño, no un parche.",
];
const trayectoria = [
  ["2026 — hoy", "Desarrollador de software / soporte TI", "Instituto Asunción de Querétaro"],
  ["2026 — hoy", "Cofundador y director de proyectos", "AutoNoma MX"],
  ["2026", "Ingeniero en Robótica y Sistemas Digitales", "Tec de Monterrey · cédula profesional"],
  ["2024–2026", "Investigación en robótica suave", "Hybrid Soft Robotics Lab · Best Poster 2025"],
];
const vid = id => `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&controls=0&loop=1&playlist=${id}&modestbranding=1&playsinline=1`;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
