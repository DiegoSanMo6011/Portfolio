<meta name="description" content="Resuelvo problemas complejos con sistemas funcionales. Dos sistemas en producción en un colegio y tres puntos de venta con clientes reales." />
<link rel="canonical" href="https://diegogerardo.com/" />
<meta property="og:site_name" content="Gerardo Sánchez (SanMo)" />
<meta property="og:type" content="website" />
<meta property="og:title" content="Gerardo Sánchez — product engineer" />
<meta property="og:description" content="Resuelvo problemas complejos con sistemas funcionales. Dos sistemas en producción en un colegio y tres POS con clientes reales." />
<meta property="og:url" content="https://diegogerardo.com/" />
<meta property="og:image" content="https://diegogerardo.com/assets/img/profile.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Gerardo Sánchez — product engineer" />
<meta name="twitter:description" content="Resuelvo problemas complejos con sistemas funcionales. Dos sistemas en producción y tres POS con clientes reales." />
<meta name="twitter:image" content="https://diegogerardo.com/assets/img/profile.jpg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=JetBrains+Mono:wght@400;600&family=Pixelify+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
<link rel="icon" type="image/png" href="/assets/img/marca/favicon-32.png" />
<link rel="apple-touch-icon" href="/assets/img/marca/apple-touch-icon.png" />
<style>
  :root{
    --bg:#16171a; --panel:#1c1e22; --panel2:#191b1f; --ink:#ecebe7; --mut:#9a9ca0; --dim:#6c6f74;
    --line:#2f3237; --acc:#d8a657; --ok:#8ab873; --warn:#d98b5a; --proto:#c7b26a;
    --sans:'Inter',ui-sans-serif,system-ui,sans-serif; --serif:'Newsreader',Georgia,serif;
    --mono:'JetBrains Mono',ui-monospace,Menlo,monospace; --pixel:'Pixelify Sans',monospace;
    --spray:#e8433a;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.6 var(--sans);-webkit-font-smoothing:antialiased}
  a{color:var(--acc);text-decoration:none} a:hover{text-decoration:underline}
  .wrap{max-width:820px;margin:0 auto;padding:0 20px}
  /* top bar */
  nav{position:sticky;top:0;z-index:30;background:rgba(22,23,26,.82);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:56px}
  nav .nm{font:600 14px var(--mono);letter-spacing:.02em}
  nav .k{font:12px var(--mono);color:var(--mut);border:1px solid var(--line);border-radius:6px;padding:6px 10px;cursor:pointer}
  nav .k:hover{color:var(--ink);border-color:var(--dim)}
  nav .links{display:flex;align-items:center;gap:22px}
  nav .lnk{font:12px var(--mono);color:var(--mut);text-transform:lowercase;transition:color .2s}
  nav .lnk:hover{color:var(--ink);text-decoration:none}
  nav .lnk.contacto{color:var(--acc)} nav .lnk.contacto:hover{text-decoration:underline}
  nav .k .k-mob{display:none}
  @media (max-width:640px){nav .lnk{display:none}nav .k .k-desk{display:none}nav .k .k-mob{display:inline}}
  /* marca: calavera + alias pixel */
  .brand{display:flex;align-items:center;gap:9px}
  .brand img{height:26px;width:auto;display:block}
  .brand .mark{font:700 21px/1 var(--pixel);color:var(--acc);letter-spacing:.01em}
  .alias{font:600 .5em/1 var(--pixel);color:var(--spray);letter-spacing:.02em;vertical-align:.12em;margin-left:6px}
  /* héroe con la calavera */
  .hero{display:grid;gap:26px;align-items:center}
  .hero-art{justify-self:center}
  .hero-art img{width:100%;max-width:250px;height:auto;display:block;filter:drop-shadow(0 6px 22px rgba(232,67,58,.14))}
  @media(min-width:721px){ .hero{grid-template-columns:1fr 250px} .hero-art{justify-self:end} }
  /* nameplate: la bomba SanMo como firma del héroe */
  .hero-bomba{margin:30px 0 2px}
  .hero-bomba img{width:100%;max-width:600px;height:auto;display:block;
    filter:drop-shadow(0 6px 20px rgba(0,0,0,.45))}
  /* bomba en quién */
  .bomba{margin:22px 0 0;border-top:1px solid var(--line);padding-top:20px}
  .bomba img{width:100%;max-width:440px;height:auto;display:block}
  .bomba figcaption{color:var(--dim);font:12px/1.5 var(--mono);margin-top:8px}
  .mundos{color:var(--mut);max-width:60ch;margin:4px 0 0}
  .mundos b{color:var(--ink);font-weight:600}
  /* Kali (gata) — marca provisional */
  .kali-mark{display:flex;align-items:center;gap:12px;margin-top:16px;color:var(--dim);font:12px var(--mono)}
  .kali-mark svg{flex:none}
  .kali-mark .eye{fill:var(--pixel-green,#c7e070)}
  /* secciones */
  section{padding:56px 0;border-top:1px solid var(--line)}
  section:first-of-type{border-top:0}
  .rotulo{font:600 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--dim);margin:0 0 10px}
  .afirma{font-family:var(--serif);font-weight:400;letter-spacing:.005em}
  h1{font-size:14px;font-weight:600;margin:0 0 18px;color:var(--mut)}
  .lede{font-size:clamp(28px,6vw,42px);line-height:1.12;margin:0 0 18px;max-width:17ch}
  .apoyo{font-size:18px;color:var(--mut);max-width:60ch;margin:0 0 6px}
  .shead{font-size:clamp(22px,4.5vw,28px);line-height:1.2;margin:0 0 8px;max-width:30ch}
  .sintro{color:var(--mut);max-width:60ch;margin:0 0 28px}
  /* reporte de estado (hero) */
  .reporte{border-top:1px solid var(--line);margin-top:30px}
  .fila{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
  .fila .dotp{width:8px;height:8px;border-radius:50%;flex:none}
  .fila .sis{font-weight:600;min-width:92px}
  .fila .est{font:600 11px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase}
  .fila .meta{margin-left:auto;color:var(--dim);font-size:14px}
  .g{color:var(--ok)} .a{color:var(--proto)} .d{color:var(--dim)}
  .bg-g{background:var(--ok)} .bg-a{background:var(--proto)} .bg-d{background:var(--dim)}
  /* sistema */
  .sis-block{margin-top:40px}
  .sis-head{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
  .sis-head h3{font-size:21px;margin:0}
  .chip{font:600 10px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--line);
    border-radius:5px;padding:5px 8px}
  .res{color:var(--mut);margin:8px 0 16px;max-width:62ch}
  table.kv{width:100%;border-collapse:collapse;margin-bottom:8px}
  table.kv td{padding:9px 0;border-bottom:1px solid var(--line);vertical-align:baseline}
  table.kv td.k{color:var(--mut)}
  table.kv td.v{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;padding-left:16px}
  table.kv td.f{text-align:right;color:var(--dim);font:13px var(--mono);width:1%;white-space:nowrap;padding-left:16px}
  @media (max-width:480px){table.kv{table-layout:auto;max-width:100%}table.kv td.v,table.kv td.f{white-space:normal;overflow-wrap:anywhere;width:auto}}
  figure{margin:18px 0 0}
  figcaption{color:var(--dim);font:12px/1.5 var(--mono);margin-top:8px}
  .card{border:1px solid var(--line);border-radius:12px;background:var(--panel);overflow:hidden}
  .card.out{border-color:#3a3833}
  /* mini-app frame */
  .appbar{display:flex;align-items:center;gap:7px;padding:10px 13px;border-bottom:1px solid var(--line);background:var(--panel2)}
  .appbar .dot{width:9px;height:9px;border-radius:50%;background:#34373c}
  .appbar .ttl{margin-left:8px;font:12px var(--mono);color:var(--dim)}
  .appbody{padding:18px}
  /* heatmap sevad */
  .hm{border-collapse:collapse;width:100%}
  .hm th{font:600 12px var(--sans);color:var(--mut);text-align:center;padding:4px 6px}
  .hm th.a{text-align:left}
  .hm td{padding:3px}
  .hm td.a{color:var(--ink);font-size:13px;white-space:nowrap;padding-right:10px}
  .cell{border-radius:6px;height:34px;display:flex;align-items:center;justify-content:center;color:#0e0f11;
    font:600 13px var(--sans);font-variant-numeric:tabular-nums}
  .kpis{display:flex;gap:34px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:16px}
  .kpi .n{font:600 26px/1 var(--sans);font-variant-numeric:tabular-nums}
  .kpi .l{color:var(--mut);font-size:12px;margin-top:5px}
  /* barras ocupación satag */
  .bars{display:flex;flex-direction:column;gap:12px}
  .barrow{display:flex;align-items:center;gap:12px}
  .barrow .lab{width:58px;color:var(--mut);font-size:13px}
  .barrow .track{flex:1;height:14px;background:var(--panel2);border-radius:7px;overflow:hidden}
  .barrow .track i{display:block;height:100%;background:var(--acc);border-radius:7px}
  .barrow .num{width:44px;text-align:right;font:600 13px var(--mono);font-variant-numeric:tabular-nums}
  /* svg diagram */
  .diag{width:100%;height:auto;display:block}
  .node{fill:var(--panel2);stroke:var(--line);stroke-width:1}
  .node.out{stroke:var(--acc)}
  .ntitle{fill:var(--ink);font:600 13px var(--sans)}
  .nsub{fill:var(--mut);font:11px var(--mono)}
  .edge{stroke:var(--dim);stroke-width:1.4;fill:none;marker-end:url(#arw)}
  .core{fill:var(--panel2);stroke:var(--acc);stroke-width:1.4}
  .coretitle{fill:var(--acc);font:600 13px var(--sans)}
  .pill{fill:none;stroke:var(--ok)} .pilltxt{fill:var(--ok);font:600 11px var(--mono)}
  /* videos */
  .reel{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .reel .v{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel)}
  .reel .frame{position:relative;padding-top:56.25%}
  .reel iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .reel .cap{padding:9px 12px;font:12px var(--mono);color:var(--mut);text-align:center}
  /* autonoma */
  .an-head{display:flex;align-items:center;gap:16px;margin-bottom:18px}
  .an-head img{height:40px;width:auto}
  .caso{display:flex;align-items:baseline;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}
  .caso .cn{font-weight:600;min-width:120px}
  .caso .cd{color:var(--mut);font-size:14px}
  .caso .cx{margin-left:auto;font:11px var(--mono);color:var(--ok);white-space:nowrap}
  /* principios */
  ol.pr{margin:0;padding:0;list-style:none;counter-reset:p}
  ol.pr li{counter-increment:p;border-bottom:1px solid var(--line);padding:15px 0 15px 36px;position:relative;font-size:18px}
  ol.pr li::before{content:counter(p);position:absolute;left:0;top:17px;font:600 12px var(--mono);color:var(--acc)}
  /* trayectoria */
  .tray{width:100%;border-collapse:collapse}
  .tray td{padding:12px 0;border-bottom:1px solid var(--line);vertical-align:baseline}
  .tray td.y{color:var(--dim);font:13px var(--mono);white-space:nowrap;width:1%;padding-right:16px}
  .tray td.r{font-weight:600} .tray td.p{color:var(--mut);text-align:right;padding-left:16px}
  /* quién */
  .quien{display:flex;gap:22px;align-items:flex-start}
  .quien img{width:104px;height:104px;border-radius:10px;object-fit:cover;border:1px solid var(--line);flex:none}
  .quien .nota{margin-top:10px;color:var(--dim);font:13px var(--mono)}
  footer{border-top:1px solid var(--line);padding:30px 0;color:var(--dim);font:13px var(--mono);text-align:center}
  footer img{height:34px;width:auto;opacity:.85;margin-bottom:12px}
  footer .fmark{font:700 16px var(--pixel);color:var(--acc);display:block;margin-bottom:6px}
  /* command palette */
  #cmdk{position:fixed;inset:0;z-index:50;background:rgba(10,11,13,.6);display:none;align-items:flex-start;justify-content:center;padding-top:14vh}
  #cmdk.open{display:flex}
  #cmdk .box{width:min(520px,92vw);background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5)}
  #cmdk input{width:100%;border:0;background:var(--panel2);color:var(--ink);padding:15px 16px;font:15px var(--sans);outline:none;border-bottom:1px solid var(--line)}
  #cmdk a{display:flex;justify-content:space-between;padding:12px 16px;color:var(--ink);border-bottom:1px solid var(--line)}
  #cmdk a:last-child{border-bottom:0} #cmdk a:hover,#cmdk a.sel{background:var(--panel2);text-decoration:none}
  #cmdk a span.k{font:11px var(--mono);color:var(--dim)}
  @media (max-width:640px){ .reel{grid-template-columns:1fr} .fila .meta{display:none} }
  @media (prefers-reduced-motion:no-preference){
    .fade{opacity:0;transform:translateY(8px);animation:up .5s ease forwards}
    @keyframes up{to{opacity:1;transform:none}}
  }
</style>
</head>
<body>
<nav><div class="wrap"><a class="brand" href="#inicio"><img src="/assets/img/marca/calavera-head.webp" width="32" height="26" alt="" aria-hidden="true" /><span class="mark">SanMo</span></a><div class="links"><a class="lnk" href="/autonoma">autónoma</a><a class="lnk" href="#sistemas">proyectos</a><a class="lnk" href="/certificates">certificados</a><a class="lnk" href="/about">sobre mí</a><a class="lnk contacto" href="mailto:diegogerardosanchez3@gmail.com">contacto</a><span class="k" id="kbtn"><span class="k-desk">⌘K</span><span class="k-mob">menú</span></span></div></div></nav>

<main class="wrap">
  <!-- HERO -->
  <section id="inicio" class="fade">
    <div class="hero">
      <div class="hero-txt">
        <p class="rotulo">Product engineer · founding engineer · abierto a remoto</p>
        <h1>Gerardo Sánchez <span class="alias">SanMo</span></h1>
        <p class="lede afirma">Resuelvo problemas complejos con sistemas funcionales.</p>
        <p class="apoyo">Dos sistemas en producción en un colegio y tres puntos de venta con clientes reales en mi empresa. Soportados por mi diseño de base de datos, seguridad y privacidad.</p>
      </div>
      <div class="hero-art"><img src="/assets/img/marca/calavera-roja.webp" width="514" height="715" alt="Calavera de ojos de corazón — la marca de Gerardo (SanMo)" /></div>
    </div>
    <div class="hero-bomba"><img src="/assets/img/marca/bomba-sanmo.svg" width="2682" height="957" alt="SanMo — bomba de grafiti pintada por Gerardo" /></div>
    <div class="reporte">
      <div class="fila"><span class="dotp bg-g"></span><span class="sis">SATAG</span><span class="est g">En producción</span><span class="meta">acceso vehicular · desde sep 2026</span></div>
      <div class="fila"><span class="dotp bg-g"></span><span class="sis">SEVAD</span><span class="est g">En producción</span><span class="meta">evaluación por QR · desde jun 2026</span></div>
      <div class="fila"><span class="dotp bg-a"></span><span class="sis">SIVEA</span><span class="est a">Prototipo</span><span class="meta">entrega de alumnos · desde sep 2026</span></div>
      <div class="fila"><span class="dotp bg-g"></span><span class="sis">AutoNoma</span><span class="est g">3 en producción</span><span class="meta">POS con clientes reales</span></div>
    </div>
  </section>

  <!-- SISTEMAS EN PRODUCCIÓN -->
  <section id="sistemas">
    <p class="rotulo">## sistemas</p>
    <h2 class="shead afirma">Todo lo que ves está en producción o es un prototipo que funciona.</h2>
    <p class="sintro">Los de mayor impacto son del colegio: por un acuerdo de confidencialidad con el Instituto no puedo mostrar su código ni capturas reales. Los cuento con un diagrama del problema y una reconstrucción con datos de ejemplo.</p>

    <!-- SATAG -->
    <div class="sis-block">
      <div class="sis-head"><h3>SATAG</h3><span class="chip g">En producción</span></div>
      <p class="res">Reemplacé papel y hoja de cálculo por la plataforma que opera el acceso vehicular del colegio: solicitud con firma, caja, inventario e integración con las plumas.</p>
      <table class="kv">
        <tr><td class="k">Eventos de acceso guardados</td><td class="v">62,391</td><td class="f">3-nov-2026</td></tr>
        <tr><td class="k">Carga del tablero</td><td class="v">de 41 s a ~6 s</td><td class="f">30-oct-2026</td></tr>
        <tr><td class="k">Migraciones SQL reversibles</td><td class="v">105</td><td class="f">3-nov-2026</td></tr>
        <tr><td class="k">Tablas, todas con seguridad a nivel de fila</td><td class="v">40</td><td class="f">3-nov-2026</td></tr>
      </table>
      <figure>
        <svg class="diag" viewBox="0 0 820 300" role="img" aria-label="SATAG concilia cuatro fuentes de datos en un expediente">
          <defs><marker id="arw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#6c6f74"/></marker></defs>
          <rect class="node" x="10" y="16" width="176" height="46" rx="8"/><text class="ntitle" x="26" y="38">Control de acceso (ZK)</text><text class="nsub" x="26" y="54">bitácora + padrón</text>
          <rect class="node" x="10" y="80" width="176" height="46" rx="8"/><text class="ntitle" x="26" y="102">Hoja histórica</text><text class="nsub" x="26" y="118">el proceso anterior</text>
          <rect class="node" x="10" y="176" width="176" height="46" rx="8"/><text class="ntitle" x="26" y="198">Sistema escolar</text><text class="nsub" x="26" y="214">quién es y si sigue</text>
          <rect class="node" x="10" y="240" width="176" height="46" rx="8"/><text class="ntitle" x="26" y="262">SATAG</text><text class="nsub" x="26" y="278">solicitud + firma</text>
          <path class="edge" d="M186,39 C270,39 280,128 338,144"/><path class="edge" d="M186,103 C270,103 280,140 338,152"/>
          <path class="edge" d="M186,199 C270,199 280,168 338,160"/><path class="edge" d="M186,263 C270,263 280,180 338,168"/>
          <rect class="core" x="340" y="104" width="232" height="96" rx="12"/><text class="coretitle" x="358" y="134">Motor de conciliación</text><text class="nsub" x="358" y="154">reglas de cuál fuente manda</text>
          <rect class="pill" x="358" y="166" width="196" height="24" rx="12" stroke-width="1"/><text class="pilltxt" x="370" y="182">comparación de nombres · es-MX</text>
          <path class="edge" d="M572,138 C630,138 640,74 696,70"/><path class="edge" d="M572,166 C630,166 640,226 696,230"/>
          <rect class="node out" x="698" y="46" width="112" height="48" rx="8"/><text class="ntitle" x="712" y="68">Expediente</text><text class="nsub" x="712" y="84">una verdad</text>
          <rect class="node out" x="698" y="206" width="112" height="48" rx="8"/><text class="ntitle" x="712" y="228">ZK: altas/bajas</text><text class="nsub" x="712" y="244">por lotes</text>
        </svg>
        <figcaption>Diagrama. 102 cambios guiados, 73 verificados, 0 descoordinaciones (3-nov-2026).</figcaption>
      </figure>
      <figure>
        <div class="card out">
          <div class="appbar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="ttl">tablero · ocupación del estacionamiento</span></div>
          <div class="appbody">
            <div class="kpis">
              <div class="kpi"><div class="n">1,774</div><div class="l">Accesos por día hábil</div></div>
              <div class="kpi"><div class="n">73</div><div class="l">En los 15 min pico</div></div>
              <div class="kpi"><div class="n g">~6 s</div><div class="l">Carga del tablero</div></div>
