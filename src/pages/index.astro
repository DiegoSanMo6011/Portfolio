<script>
  const k = document.getElementById('cmdk'), q = document.getElementById('cmdq'), btn = document.getElementById('kbtn');
  const open = () => { k.classList.add('open'); q.value=''; filter(); q.focus(); };
  const close = () => k.classList.remove('open');
  const links = () => Array.from(document.querySelectorAll('#cmdlist a'));
  function filter(){ const t=q.value.toLowerCase(); links().forEach(a=>{ a.style.display = a.textContent.toLowerCase().includes(t)?'flex':'none'; }); }
  btn.addEventListener('click', open);
  q.addEventListener('input', filter);
  document.addEventListener('keydown', e => {
    if ((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){ e.preventDefault(); k.classList.contains('open')?close():open(); }
    else if (e.key==='Escape') close();
    else if (k.classList.contains('open') && e.key==='Enter'){ const v=links().find(a=>a.style.display!=='none'); if(v){ close(); v.click(); } }
  });
  k.addEventListener('click', e => { if(e.target===k) close(); });
</script>
