---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// 1. Obtener proyectos
const allProjects = await getCollection('projects');
// 2. Ordenar por prioridad, destacados y fecha
const sortedProjects = allProjects.sort((a, b) => {
  const aPriority = a.data.priority ?? 999;
  const bPriority = b.data.priority ?? 999;
  if (aPriority !== bPriority) return aPriority - bPriority;
  const featuredDiff = (b.data.featured === true) - (a.data.featured === true);
  if (featuredDiff !== 0) return featuredDiff;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

// Definimos los badges aquí para mantener el HTML limpio
const skillBadges = ["Robotics Software", "Computer Vision", "Full Stack", "Embedded Systems"];

// Stats de Autónoma (fuente: hechos verificados)
const autonomaStats = [
  { value: 6, suffix: "", label: "productos construidos" },
  { value: 3, suffix: "", label: "sistemas en producción" },
  { value: 465, suffix: "", label: "commits" },
  { value: 185000, suffix: "+", label: "líneas de código" },
];

// Casos destacados de Autónoma
const autonomaCasos = [
  {
    nombre: "OptiNoma",
    href: "/autonoma/optinoma",
    badge: "En producción",
    badgeClass: "text-green-400 bg-green-400/10 border-green-400/20",
    descripcion:
      "POS para ópticas: etiquetas de código de barras, órdenes de laboratorio y operación sin internet. En Óptica Los Ángeles, Querétaro.",
  },
  {
    nombre: "POS Lite",
    href: "/autonoma/pos-lite",
    badge: "En producción",
    badgeClass: "text-green-400 bg-green-400/10 border-green-400/20",
    descripcion:
      "POS para cafeterías y micro-negocios: venta en menos de 15 segundos, corte de caja con folio y operación sin internet. En una cafetería de Querétaro.",
  },
  {
    nombre: "Analítica de negocios",
    href: "/autonoma/analitica",
    badge: "Plataforma SaaS",
    badgeClass: "text-cyan-400 bg-cyan-400/10 border-cyan-400/20",
    descripcion:
      "Analítica de negocio con dashboards alimentados en tiempo real por el POS en producción y asistente de IA que responde sobre las ventas.",
  },
];
---

<MainLayout
  title="Inicio"
  description="Portafolio de Diego Gerardo: ingeniero en Robótica y Sistemas Digitales, cofundador de Autónoma. Sistemas POS en producción, ROS 2, visión artificial y sistemas embebidos."
>
  
  <div class="flex flex-col items-center justify-center min-h-[45vh] text-center pt-20 mb-12">
    
    <div class="mb-6">
      <span class="px-3 py-1 text-xs font-mono font-medium tracking-wider text-green-400 uppercase bg-green-400/10 rounded-full border border-green-400/20 animate-pulse">
        Disponible para colaborar
      </span>
    </div>

    <h1 class="text-5xl md:text-7xl font-extrabold mb-4 tracking-tight text-white">
      Diego Gerardo <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-600">Sánchez Moreno</span>
    </h1>

    <h2 class="text-2xl md:text-3xl font-bold text-slate-200 mb-2 tracking-tight">
      Ingeniero en Robótica y Sistemas Digitales
    </h2>

    <p class="text-sm font-mono text-slate-400 tracking-wide mb-5">
      Tec de Monterrey · Cédula profesional 15796458
    </p>

    <a
      href="#autonoma"
      class="inline-flex items-center gap-2.5 px-4 py-2 mb-6 text-sm font-medium text-slate-200 bg-[#134F9F]/20 border border-[#134F9F]/60 rounded-full hover:border-cyan-400/60 hover:bg-[#134F9F]/30 transition-all"
    >
      <span class="w-2 h-2 rounded-full bg-cyan-400" aria-hidden="true"></span>
      Cofundador de Autónoma — sistemas POS y analítica en producción
    </a>

    <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-6 leading-relaxed">
      Desarrollo de software para robótica, percepción y sistemas autónomos. <br class="hidden sm:block" />
      Especializado en <strong class="text-cyan-400">ROS 2</strong>, <strong class="text-cyan-400">Visión Artificial</strong> e integración de sistemas embebidos.
    </p>

    <div class="flex flex-wrap justify-center gap-3 mb-10">
      {skillBadges.map((badge) => (
        <span class="px-4 py-1.5 text-sm font-mono font-medium text-cyan-200 bg-slate-800/50 rounded-lg border border-slate-700 hover:border-cyan-500/50 hover:bg-cyan-900/20 transition-all cursor-default select-none shadow-sm">
          {badge}
        </span>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row flex-wrap gap-4 w-full sm:w-auto">
      <a href="#proyectos" class="inline-flex justify-center items-center px-8 py-3.5 text-base font-bold text-white bg-gradient-to-r from-blue-600 to-cyan-600 rounded-lg hover:from-blue-500 hover:to-cyan-500 transition-all shadow-lg shadow-blue-500/20 hover:scale-[1.02]">
        Ver Proyectos
      </a>
      <a href="/assets/docs/Diego-Gerardo-Sanchez-Moreno-CV-Robotics.pdf" class="inline-flex justify-center items-center px-8 py-3.5 text-base font-bold text-slate-900 bg-cyan-400 rounded-lg hover:bg-cyan-300 transition-all shadow-lg shadow-cyan-500/20">
        CV Robotics
      </a>
      <a href="/assets/docs/Diego-Gerardo-Sanchez-Moreno-CV-Software.pdf" class="inline-flex justify-center items-center px-8 py-3.5 text-base font-bold text-slate-900 bg-cyan-400 rounded-lg hover:bg-cyan-300 transition-all shadow-lg shadow-cyan-500/20">
        CV Software
      </a>
      <a href="/cv" class="inline-flex justify-center items-center px-8 py-3.5 text-base font-medium text-slate-200 bg-slate-900 border border-slate-700 rounded-lg hover:border-cyan-400 hover:text-white transition-all">
        Ver CVs
      </a>
      <a href="https://github.com/DiegoSanMo6011" target="_blank" class="inline-flex justify-center items-center px-8 py-3.5 text-base font-medium text-slate-300 bg-slate-800 border border-slate-700 rounded-lg hover:bg-slate-700 hover:text-white transition-all font-mono">
        GitHub
      </a>
    </div>

  </div>

  <section id="autonoma" class="py-10 scroll-mt-24">
    <h2 class="text-3xl font-bold text-slate-100 mb-8 flex items-center gap-3 reveal">
      <span class="text-cyan-400">/</span> Autónoma
    </h2>

    <div class="relative overflow-hidden rounded-2xl border border-slate-700 bg-slate-800/50 reveal">
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#134F9F]/25 via-transparent to-cyan-500/10 pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative p-6 sm:p-10">
        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10 mb-10">
          <img
            src="/assets/img/autonoma/logo-autonoma-white.png"
            alt="Logo de Autónoma"
            width="877"
            height="772"
            loading="lazy"
            class="h-24 md:h-28 w-auto shrink-0 reveal"
            style="--reveal-delay: 80ms"
          />
          <div class="text-center md:text-left reveal" style="--reveal-delay: 160ms">
            <p class="text-lg md:text-xl text-slate-200 leading-relaxed mb-2">
              Empresa de ingeniería de software fundada en 2026 en Querétaro, con
              <strong class="text-white">3 sistemas POS en producción</strong> operando con clientes reales.
            </p>
            <p class="text-slate-400 leading-relaxed">
              Cada proyecto se dirige con metodología PMBOK: acta de constitución, plan de dirección, capacitación y garantía por escrito.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          {autonomaStats.map((stat, i) => (
            <div
              class="text-center rounded-xl border border-slate-700 bg-slate-900/50 p-5 reveal"
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <p class="text-3xl md:text-4xl font-extrabold font-mono text-cyan-400 mb-1">
                <span data-countup={stat.value} data-countup-suffix={stat.suffix}>0</span>
              </p>
              <p class="text-sm text-slate-400">{stat.label}</p>
            </div>
          ))}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
          {autonomaCasos.map((caso, i) => (
            <a
              href={caso.href}
              class="group flex flex-col rounded-xl border border-slate-700 bg-slate-900/50 p-5 hover:border-cyan-500/50 transition-all reveal"
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <div class="flex items-center justify-between gap-2 mb-3">
                <h3 class="text-lg font-bold text-white">{caso.nombre}</h3>
                <span class={`px-2 py-0.5 text-[11px] font-mono uppercase tracking-wider border rounded-full whitespace-nowrap ${caso.badgeClass}`}>
                  {caso.badge}
                </span>
              </div>
              <p class="text-sm text-slate-400 leading-relaxed flex-grow">
                {caso.descripcion}
              </p>
              <span class="mt-4 text-sm font-mono text-cyan-400 group-hover:translate-x-1 transition-transform self-start">
                Ver caso →
              </span>
            </a>
          ))}
        </div>

        <div class="text-center reveal" style="--reveal-delay: 200ms">
          <a
            href="/autonoma"
            class="inline-flex justify-center items-center px-10 py-4 text-lg font-bold text-white bg-[#134F9F] rounded-lg hover:bg-[#1A5FBE] transition-all shadow-lg shadow-[#134F9F]/30 hover:scale-[1.02]"
          >
            Conocer Autónoma →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-6">
    <h2 class="text-3xl font-bold text-slate-100 mb-8 flex items-center gap-3">
      <span class="text-cyan-400">/</span> Demo Reel
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        {
          title: 'Soft Robotics — Demo Final',
          url: 'https://www.youtube.com/embed/Nmk_etXFZ6o?autoplay=1&mute=1&controls=0&loop=1&playlist=Nmk_etXFZ6o&modestbranding=1&playsinline=1',
        },
        {
          title: 'PuzzleBot — Demo Final',
          url: 'https://www.youtube.com/embed/sOlqaHjRg6w?autoplay=1&mute=1&controls=0&loop=1&playlist=sOlqaHjRg6w&modestbranding=1&playsinline=1',
        },
        {
          title: 'Line‑Maze Solver — Demo',
          url: 'https://www.youtube.com/embed/7IuBa7F5US0?autoplay=1&mute=1&controls=0&loop=1&playlist=7IuBa7F5US0&modestbranding=1&playsinline=1',
        },
      ].map((video) => (
        <div class="rounded-2xl border border-slate-700/70 bg-slate-900/40 overflow-hidden shadow-2xl shadow-cyan-500/10">
          <div class="relative pt-[56.25%]">
            <iframe
              class="absolute inset-0 w-full h-full"
              src={video.url}
              title={video.title}
              frameborder="0"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <div class="px-4 py-3 text-sm text-slate-300 font-mono text-center">
            {video.title}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="proyectos" class="py-10">
    <h2 class="text-3xl font-bold text-slate-100 mb-8 flex items-center gap-3">
      <span class="text-cyan-400">/</span> Proyectos Destacados
    </h2>

    {sortedProjects.length === 0 ? (
      <div class="text-center p-12 border border-dashed border-slate-800 bg-slate-800/20 rounded-xl text-slate-500">
        <p class="text-lg">Cargando proyectos o carpeta vacía...</p>
        <p class="text-sm mt-2">Verifica <code>src/content/projects/</code></p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map((project) => (
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            status={project.data.status}
            featured={project.data.featured}
            link={`/projects/${project.slug}`}
            githubLink={project.data.githubUrl}
          />
        ))}
      </div>
    )}

  </section>

</MainLayout>
