---
// Navbar unificado con el rediseño: calavera + SanMo (pixel), acento ámbar.
const navItems = [
  { name: 'autónoma', url: '/autonoma' },
  { name: 'proyectos', url: '/#sistemas' },
  { name: 'certificados', url: '/certificates' },
  { name: 'sobre mí', url: '/about' },
];
---

<nav class="site-nav">
  <div class="wrap">
    <a href="/" class="brand">
      <img src="/assets/img/marca/calavera-head.webp" width="32" height="26" alt="" aria-hidden="true" />
      <span class="mark">SanMo</span>
    </a>

    <div class="links">
      {navItems.map((item) => (
        <a href={item.url} class="lnk">{item.name}</a>
      ))}
      <a href="mailto:diegogerardosanchez3@gmail.com" class="contacto">contacto</a>
    </div>

    <button type="button" class="burger"
      onclick="document.getElementById('mobile-menu').classList.toggle('open')"
      aria-label="Abrir menú">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div class="mobile" id="mobile-menu">
    {navItems.map((item) => (
      <a href={item.url}>{item.name}</a>
    ))}
    <a href="mailto:diegogerardosanchez3@gmail.com" class="contacto">contacto</a>
  </div>
</nav>

<style>
  .site-nav{position:fixed;top:0;left:0;width:100%;z-index:50;
    background:rgba(22,23,26,.82);backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);height:56px}
  .wrap{max-width:900px;margin:0 auto;padding:0 20px;height:100%;
    display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;gap:9px;text-decoration:none}
  .brand img{height:26px;width:auto;display:block}
  .brand .mark{font:700 21px/1 var(--pixel);color:var(--acc);letter-spacing:.01em}
  .links{display:flex;align-items:center;gap:22px}
  .lnk{font:12px var(--mono);color:var(--mut);text-decoration:none;
    text-transform:lowercase;transition:color .2s}
  .lnk:hover{color:var(--ink)}
  .contacto{font:12px var(--mono);color:var(--acc);text-decoration:none}
  .contacto:hover{text-decoration:underline}
  .burger{display:none;background:none;border:0;color:var(--mut);cursor:pointer;padding:6px}
  .mobile{display:none;flex-direction:column;gap:2px;position:absolute;top:56px;left:0;width:100%;
    background:var(--panel);border-bottom:1px solid var(--line);padding:10px 20px 16px}
  .mobile.open{display:flex}
  .mobile a{font:14px var(--mono);color:var(--mut);text-decoration:none;padding:10px 0;
    border-bottom:1px solid var(--line);text-transform:lowercase}
  .mobile a:last-child{border-bottom:0}
  .mobile .contacto{color:var(--acc)}
  @media(max-width:720px){ .links{display:none} .burger{display:inline-flex} }
</style>
