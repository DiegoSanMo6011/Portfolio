---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <img src="/assets/img/marca/calavera-head.png" alt="" aria-hidden="true" />
  <span class="fmark">SanMo</span>
  <div class="social">
    <a href="https://github.com/DiegoSanMo6011" target="_blank" rel="noopener">GitHub</a>
    <span class="sep">·</span>
    <a href="https://www.linkedin.com/in/diego-gerardo-sánchez-moreno-73549a296" target="_blank" rel="noopener">LinkedIn</a>
    <span class="sep">·</span>
    <a href="/cv">CV</a>
    <span class="sep">·</span>
    <a href="mailto:diegogerardosanchez3@gmail.com">correo</a>
  </div>
  <p class="line">Hecho por Gerardo Sánchez · Querétaro, México · © {currentYear}</p>
</footer>

<style>
  .site-footer{border-top:1px solid var(--line);padding:34px 20px;margin-top:auto;
    text-align:center;color:var(--dim);font:13px var(--mono)}
  .site-footer img{height:34px;width:auto;opacity:.85;margin-bottom:12px}
  .fmark{display:block;font:700 16px var(--pixel);color:var(--acc);margin-bottom:14px}
  .social{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:10px}
  .social a{color:var(--mut);text-decoration:none}
  .social a:hover{color:var(--ink)}
  .social .sep{color:var(--dim)}
  .line{margin:0;color:var(--dim)}
</style>
