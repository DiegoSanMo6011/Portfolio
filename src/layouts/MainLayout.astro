---
// --- ZONA DE SERVIDOR (Server Side) ---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const site = Astro.site;
const pageTitle = `${title} | Diego Gerardo`;
const metaDescription =
  description ??
  'Portafolio de Diego Gerardo. Ingeniería en Robótica y Sistemas Digitales, ROS 2, Visión Artificial y desarrollo de software.';
const canonicalUrl = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.toString();
const ogImage = site
  ? new URL(image ?? '/assets/img/profile.jpg', site).toString()
  : image ?? '/assets/img/profile.jpg';
const robotsContent = noindex ? 'noindex,nofollow' : 'index,follow';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={metaDescription} />
        <meta name="viewport" content="width=device-width" />
        <meta name="robots" content={robotsContent} />
        <link rel="icon" type="image/png" href="/assets/img/marca/favicon-32.png" />
        <link rel="apple-touch-icon" href="/assets/img/marca/apple-touch-icon.png" />
        <meta name="generator" content={Astro.generator} />

        <title>{pageTitle}</title>
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:site_name" content="Gerardo Sánchez (SanMo)" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImage} />
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=JetBrains+Mono:wght@400;600&family=Pixelify+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    </head>
    <body class="antialiased flex flex-col min-h-screen">

        <Navbar />

        <main class="flex-grow w-full max-w-4xl mx-auto px-5 pt-24 pb-16">
            <slot />
        </main>

        <Footer />

    </body>
</html>

<style is:global>
  /* ── Sistema de diseño unificado (del rediseño) ── */
  :root{
    --bg:#16171a; --panel:#1c1e22; --panel2:#191b1f; --ink:#ecebe7; --mut:#9a9ca0; --dim:#6c6f74;
    --line:#2f3237; --acc:#d8a657; --ok:#8ab873; --warn:#d98b5a; --proto:#c7b26a; --spray:#e8433a;
    --sans:'Inter',ui-sans-serif,system-ui,sans-serif; --serif:'Newsreader',Georgia,serif;
    --mono:'JetBrains Mono',ui-monospace,Menlo,monospace; --pixel:'Pixelify Sans',monospace;
  }
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);
    font:400 16px/1.6 var(--sans);-webkit-font-smoothing:antialiased;
    scrollbar-color:var(--line) var(--bg);}
  ::selection{background:rgba(216,166,74,.28);color:var(--ink)}
  a{color:var(--acc)}
  h1,h2,h3{color:var(--ink)}
  /* Forzamos la fuente mono solo para bloques de código */
  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Animación de entrada al hacer scroll: agregar class="reveal" (+ --reveal-delay opcional).
     El contenido es visible por omisión (sin JS, al imprimir, en lectores, vistas previas y
     capturas). Al primer scroll, el script marca .is-hidden solo lo que está fuera de pantalla
     y lo va revelando al entrar. */
  .reveal {
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .reveal.is-hidden {
    opacity: 0;
    transform: translateY(24px);
  }
  @media (prefers-reduced-motion: reduce), print {
    .reveal {
      transition: none;
    }
    .reveal.is-hidden {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Reveal al hacer scroll + contadores animados (data-countup)
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
  if (!reducedMotion && revealEls.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove('is-hidden');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    // Hasta el primer scroll todo se ve; ahí se oculta solo lo que está abajo de la pantalla.
    const armar = () => {
      const limite = window.innerHeight;
      for (const el of revealEls) {
        if (el.getBoundingClientRect().top > limite) {
          el.classList.add('is-hidden');
          io.observe(el);
        }
      }
    };
    window.addEventListener('scroll', armar, { once: true, passive: true });
  }

  const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');
  const renderValue = (el: HTMLElement, value: number) => {
    const suffix = el.dataset.countupSuffix ?? '';
    const prefix = el.dataset.countupPrefix ?? '';
    el.textContent = `${prefix}${Math.round(value).toLocaleString('es-MX')}${suffix}`;
  };
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.countup ?? '0');
    if (reducedMotion || !Number.isFinite(target)) {
      renderValue(el, target);
      return;
    }
    const duration = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      renderValue(el, target * eased);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const ioCount = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          ioCount.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 }
  );
  countEls.forEach((el) => ioCount.observe(el));
</script>
