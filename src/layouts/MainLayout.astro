---
// --- ZONA DE SERVIDOR (Server Side) ---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const site = Astro.site;
const pageTitle = `${title} | Diego Gerardo`;
const metaDescription =
  description ??
  'Portafolio de Diego Gerardo. Ingeniería en Robótica y Sistemas Digitales, ROS 2, Visión Artificial y desarrollo de software.';
const canonicalUrl = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.toString();
const ogImage = site
  ? new URL(image ?? '/assets/img/profile.jpg', site).toString()
  : image ?? '/assets/img/profile.jpg';
const robotsContent = noindex ? 'noindex,nofollow' : 'index,follow';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={metaDescription} />
        <meta name="viewport" content="width=device-width" />
        <meta name="robots" content={robotsContent} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        
        <title>{pageTitle}</title>
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:site_name" content="Diego Gerardo" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImage} />
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    </head>
    <body class="bg-slate-900 text-slate-50 font-sans antialiased selection:bg-cyan-500/30 selection:text-cyan-200 flex flex-col min-h-screen">
        
        <Navbar />

        <main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12">
            <slot />
        </main>

        <Footer />

    </body>
</html>

<style is:global>
  /* Forzamos la fuente mono solo para bloques de código */
  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Animación de entrada al hacer scroll: agregar class="reveal" (+ --reveal-delay opcional) */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Reveal al hacer scroll + contadores animados (data-countup)
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
  if (reducedMotion) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    revealEls.forEach((el) => io.observe(el));
  }

  const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');
  const renderValue = (el: HTMLElement, value: number) => {
    const suffix = el.dataset.countupSuffix ?? '';
    const prefix = el.dataset.countupPrefix ?? '';
    el.textContent = `${prefix}${Math.round(value).toLocaleString('es-MX')}${suffix}`;
  };
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.countup ?? '0');
    if (reducedMotion || !Number.isFinite(target)) {
      renderValue(el, target);
      return;
    }
    const duration = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      renderValue(el, target * eased);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const ioCount = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          ioCount.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 }
  );
  countEls.forEach((el) => ioCount.observe(el));
</script>
